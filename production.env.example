# ==============================================================================
# DEFECTVISION AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production (or set as environment variables in your
# hosting environment, such as Render, Railway, Fly.io, or AWS ECS/Fargate).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables.
# Replace with the public URL of your persistent FastAPI backend service.
# Example: https://defectvision-backend.onrender.com or http://your-domain.com:8001
VITE_API_URL=https://defectvision-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND RUNTIME CONFIGURATION (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Host interface and port
HOST=0.0.0.0
PORT=8001

# Operational Mode: 'production' or 'development'
ENVIRONMENT=production

# HuggingFace & Transformers cache directory and offline mode flag
# Set to '1' to prevent outbound network queries during startup if models are pre-cached
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Hardware execution device: 'cpu' or 'cuda'
# DefectVision AI automatically detects CUDA if available, falling back to CPU.
DEVICE=cpu

# ------------------------------------------------------------------------------
# 3. STORAGE & DATA PATHS
# ------------------------------------------------------------------------------
# Root directory for persistent data, profiles, and inspection history.
# For Docker or Kubernetes, mount a persistent volume to this directory.
# Defaults to DefectVisionAI/data inside the workspace if unset.
DEFECTVISION_DATA_DIR=/app/data
DEFECTVISION_PROFILES_DIR=/app/data/production_profiles

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Always include your Vercel deployment URL and local development hosts.
CORS_ORIGINS=https://defectvision-ai.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 5. LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
